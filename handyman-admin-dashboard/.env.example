# Shared/default mode: read and write the existing Firebase Job and Handyman data.
# Set this to true only for an isolated UI demo with browser-only fixture data.
REACT_APP_USE_LOCAL_FIXTURES=false

# Local AI API.
REACT_APP_LOCAL_AI_SERVICE_URL=http://127.0.0.1:8080

# Backward-compatible local URL. New environments should use the local value above.
# REACT_APP_AI_SERVICE_URL=http://127.0.0.1:8080
