{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handyman.local/contracts/job.schema.json",
  "title": "JobInput",
  "type": "object",
  "required": ["jobId", "description"],
  "additionalProperties": false,
  "properties": {
    "jobId": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "categoryHint": {"type": ["string", "null"]},
    "languageHint": {"type": ["string", "null"], "enum": ["en", "bn", "mixed", null]},
    "locationText": {"type": ["string", "null"]},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "startAt": {"type": ["string", "null"]},
    "endAt": {"type": ["string", "null"]},
    "budgetMin": {"type": ["number", "null"], "minimum": 0},
    "budgetMax": {"type": ["number", "null"], "minimum": 0}
  }
}
